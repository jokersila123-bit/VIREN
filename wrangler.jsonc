{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viren-vrn",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "viren-vrn-staging"
    },
    "production": {
      "name": "viren-vrn"
    }
  }
}
